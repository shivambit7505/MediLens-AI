# ==============================================================================
# MediLens AI - Environment Configuration Template
# Copy this file to .env and populate with deployment-specific values.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Global Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. PostgreSQL + pgvector Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=medilens_db
POSTGRES_USER=medilens_admin
POSTGRES_PASSWORD=change_this_secure_password_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medilens_admin:change_this_secure_password_in_production@postgres:5432/medilens_db

# ------------------------------------------------------------------------------
# 3. Redis Cache & Task Queue Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password_in_production
REDIS_URL=redis://:change_this_redis_password_in_production@redis:6379/0

# ------------------------------------------------------------------------------
# 4. Backend (Spring Boot) Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
JWT_SECRET=super_secret_jwt_signing_key_must_be_at_least_256_bits_long_for_hs256_alg
JWT_EXPIRATION_MS=86400000        # 24 hours
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days
AI_SERVICE_URL=http://ai-service:8000
REPORT_STORAGE_DIR=/var/medilens/reports

# ------------------------------------------------------------------------------
# 5. AI Service (FastAPI) Configuration
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
INTERNAL_API_KEY=internal_pre_shared_key_between_backend_and_ai_service
OCR_ENGINE_PRIMARY=paddleocr
OCR_ENGINE_FALLBACK=tesseract
OCR_CONFIDENCE_THRESHOLD=0.70
TESSERACT_CMD=/usr/bin/tesseract

# ------------------------------------------------------------------------------
# 6. RAG & LLM Integration Configuration
# (Used strictly for evidence-grounded summarization, NEVER for lab extraction/diagnostics)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_PROVIDER=gemini               # Options: gemini, openai, anthropic, ollama, local
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 7. Frontend (React / Vite) Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
